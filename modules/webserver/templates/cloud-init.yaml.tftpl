#cloud-config
package_update: true
package_upgrade: false

packages:
  - nginx

write_files:
  - path: /var/www/html/index.html
    permissions: '0644'
    content: |
      <!doctype html>
      <html lang="en">
        <head>
          <meta charset="utf-8">
          <meta name="viewport" content="width=device-width, initial-scale=1">
          <title>${server_label} — Moseley Development</title>
          <style>
            body {
              margin: 0;
              min-height: 100vh;
              display: flex;
              align-items: center;
              justify-content: center;
              font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
              background: ${accent_color};
              color: #fff;
            }
            .card {
              background: rgba(0, 0, 0, 0.22);
              padding: 3rem 4rem;
              border-radius: 16px;
              text-align: center;
              box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
            }
            .label { font-size: 4rem; font-weight: 800; margin: 0 0 0.5rem; letter-spacing: 1px; }
            .region { font-size: 1.4rem; opacity: 0.9; margin: 0 0 1.5rem; }
            .hint { font-size: 1rem; opacity: 0.8; margin: 0; }
          </style>
        </head>
        <body>
          <div class="card">
            <p class="label">${server_label}</p>
            <p class="region">Region: ${region}</p>
            <p class="hint">Refresh to watch Traffic Manager round-robin between servers.</p>
          </div>
        </body>
      </html>

runcmd:
  - systemctl enable nginx
  - systemctl restart nginx
